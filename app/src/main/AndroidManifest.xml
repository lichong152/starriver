<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- 桌面需要枚举全部可启动应用 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 刻意不声明 INTERNET：桌面不发起任何网络请求，壁纸全部内置，权限面越小越好 -->
    <!-- guard 形态开机自启；standard 形态系统本就会拉起桌面，属冗余声明 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 屏保：把星川屏保写成系统 screensaver_components。属系统签名级权限，
         侧载后需 adb pm grant 授权；没授权时设置里会提示，不影响其它功能 -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.StarRiver">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.StarRiver">

            <!-- 从应用列表也能打开（guard 形态靠这条入口启动） -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            桌面守护。可选功能，默认关闭，由用户在系统无障碍设置里勾选后生效。
            只声明窗口切换事件、不读窗口内容。
        -->
        <service
            android:name=".core.GuardService"
            android:exported="true"
            android:label="@string/guard_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_service" />
        </service>

        <receiver
            android:name=".core.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            待机屏保。四套样式（大时钟 / 壁纸幻灯 / 星空 / 极简），样式在设置里切换。
            只有被系统选为当前屏保时才会运行，不常驻、不联网。
        -->
        <service
            android:name=".ScreensaverService"
            android:exported="true"
            android:label="@string/screensaver_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
            </intent-filter>
        </service>
    </application>

</manifest>
